{
    "external_apis": {
        "weather_services": {
            "openweathermap": {
                "base_url": "https://api.openweathermap.org/data/2.5",
                "endpoints": {
                    "current": "/weather",
                    "forecast": "/forecast",
                    "historical": "/onecall/timemachine"
                },
                "rate_limit": {
                    "requests_per_minute": 60,
                    "requests_per_day": 1000
                },
                "cache_duration": "15 minutes",
                "error_handling": {
                    "retry_attempts": 3,
                    "retry_delay": "5 seconds",
                    "fallback_provider": "meteorological_department"
                }
            },
            "meteorological_department": {
                "base_url": "https://api.pmd.gov.pk",
                "endpoints": {
                    "current": "/current",
                    "forecast": "/forecast",
                    "alerts": "/alerts"
                },
                "rate_limit": {
                    "requests_per_minute": 30,
                    "requests_per_day": 500
                },
                "cache_duration": "30 minutes",
                "error_handling": {
                    "retry_attempts": 2,
                    "retry_delay": "10 seconds",
                    "fallback_provider": "openweathermap"
                }
            }
        },
        "air_quality_services": {
            "aqicn": {
                "base_url": "https://api.waqi.info",
                "endpoints": {
                    "current": "/feed",
                    "station": "/station",
                    "search": "/search"
                },
                "rate_limit": {
                    "requests_per_minute": 30,
                    "requests_per_day": 500
                },
                "cache_duration": "1 hour",
                "error_handling": {
                    "retry_attempts": 2,
                    "retry_delay": "5 seconds",
                    "fallback_provider": "local_stations"
                }
            },
            "local_stations": {
                "base_url": "https://api.air.sindh.gov.pk",
                "endpoints": {
                    "current": "/current",
                    "historical": "/historical",
                    "stations": "/stations"
                },
                "rate_limit": {
                    "requests_per_minute": 60,
                    "requests_per_day": 1000
                },
                "cache_duration": "15 minutes",
                "error_handling": {
                    "retry_attempts": 3,
                    "retry_delay": "5 seconds",
                    "fallback_provider": "aqicn"
                }
            }
        }
    },
    "data_validation": {
        "schemas": {
            "weather_data": {
                "required_fields": [
                    "temperature",
                    "humidity",
                    "wind_speed",
                    "timestamp"
                ],
                "data_types": {
                    "temperature": "float",
                    "humidity": "float",
                    "wind_speed": "float",
                    "timestamp": "datetime"
                },
                "validation_rules": {
                    "temperature": {
                        "min": -50,
                        "max": 50
                    },
                    "humidity": {
                        "min": 0,
                        "max": 100
                    },
                    "wind_speed": {
                        "min": 0,
                        "max": 200
                    }
                }
            },
            "air_quality_data": {
                "required_fields": [
                    "aqi",
                    "pm25",
                    "pm10",
                    "timestamp"
                ],
                "data_types": {
                    "aqi": "integer",
                    "pm25": "float",
                    "pm10": "float",
                    "timestamp": "datetime"
                },
                "validation_rules": {
                    "aqi": {
                        "min": 0,
                        "max": 500
                    },
                    "pm25": {
                        "min": 0,
                        "max": 500
                    },
                    "pm10": {
                        "min": 0,
                        "max": 600
                    }
                }
            }
        },
        "error_handling": {
            "validation_errors": {
                "action": "log_and_notify",
                "notification_level": "warning",
                "retry_strategy": "skip_and_continue"
            },
            "api_errors": {
                "action": "retry_with_backoff",
                "max_retries": 3,
                "notification_level": "error"
            }
        }
    },
    "caching_strategy": {
        "memory_cache": {
            "max_size": "1GB",
            "ttl": "1 hour",
            "eviction_policy": "lru"
        },
        "disk_cache": {
            "max_size": "10GB",
            "ttl": "7 days",
            "eviction_policy": "lru"
        },
        "cache_invalidation": {
            "triggers": [
                "data_update",
                "schema_change",
                "ttl_expiry"
            ],
            "notification": {
                "enabled": true,
                "level": "info"
            }
        }
    },
    "monitoring": {
        "api_health": {
            "check_frequency": "5 minutes",
            "metrics": [
                "response_time",
                "error_rate",
                "availability",
                "data_freshness"
            ],
            "alerts": {
                "response_time_threshold": "2 seconds",
                "error_rate_threshold": "5%",
                "availability_threshold": "99%"
            }
        },
        "data_quality": {
            "check_frequency": "1 hour",
            "metrics": [
                "completeness",
                "accuracy",
                "consistency",
                "timeliness"
            ],
            "alerts": {
                "completeness_threshold": "95%",
                "accuracy_threshold": "90%",
                "timeliness_threshold": "15 minutes"
            }
        }
    }
} 