{
    "data_sources": {
        "climate_data": {
            "district_data": {
                "file_path": "data/chatbot/district_climate_data.json",
                "update_frequency": "Monthly",
                "integration_type": "local_json",
                "data_structure": {
                    "climate_profile": ["temperature", "rainfall", "humidity", "wind"],
                    "climate_risks": ["challenges", "frequency", "impact", "vulnerable_areas"],
                    "adaptation_measures": ["infrastructure", "community", "environmental"]
                }
            },
            "sensor_data": {
                "file_path": "data/chatbot/sensor_integration.json",
                "update_frequency": "Real-time",
                "integration_type": "api_endpoints",
                "data_types": ["weather", "air_quality", "water_quality"]
            }
        },
        "research_data": {
            "papers": {
                "file_path": "data/chatbot/research_papers.json",
                "update_frequency": "Quarterly",
                "integration_type": "local_json",
                "categories": [
                    "climate_change",
                    "environmental_studies",
                    "sustainable_development",
                    "local_research"
                ]
            }
        },
        "sdg_data": {
            "indicators": {
                "file_path": "data/chatbot/sdg_indicators.json",
                "update_frequency": "Monthly",
                "integration_type": "local_json",
                "goals": ["SDG 13", "SDG 6", "SDG 11"]
            }
        }
    },
    "api_integrations": {
        "weather_services": {
            "openweathermap": {
                "config_path": "data/chatbot/api_config.json",
                "endpoints": ["current", "forecast", "historical"],
                "data_mapping": {
                    "temperature": "main.temp",
                    "humidity": "main.humidity",
                    "wind_speed": "wind.speed"
                }
            },
            "meteorological_department": {
                "config_path": "data/chatbot/api_config.json",
                "endpoints": ["current", "forecast", "alerts"],
                "data_mapping": {
                    "temperature": "temperature",
                    "rainfall": "precipitation",
                    "alerts": "warnings"
                }
            }
        },
        "air_quality_services": {
            "aqicn": {
                "config_path": "data/chatbot/api_config.json",
                "endpoints": ["current", "station", "search"],
                "data_mapping": {
                    "aqi": "aqi",
                    "pm25": "pm25",
                    "pm10": "pm10"
                }
            }
        }
    },
    "ml_integration": {
        "models": {
            "config_path": "data/chatbot/ml_config.json",
            "active_models": [
                "climate_prediction",
                "air_quality_prediction",
                "water_quality_prediction"
            ],
            "prediction_frequency": {
                "weather": "Daily",
                "air_quality": "Hourly",
                "water_quality": "Daily"
            }
        }
    },
    "data_processing": {
        "validation": {
            "schemas": {
                "weather_data": "data/chatbot/api_config.json",
                "air_quality_data": "data/chatbot/api_config.json"
            },
            "rules": {
                "temperature_range": [-50, 50],
                "humidity_range": [0, 100],
                "aqi_range": [0, 500]
            }
        },
        "transformation": {
            "unit_conversion": {
                "temperature": "celsius",
                "wind_speed": "km/h",
                "precipitation": "mm"
            },
            "data_aggregation": {
                "time_periods": ["hourly", "daily", "monthly"],
                "metrics": ["average", "maximum", "minimum"]
            }
        }
    },
    "chatbot_integration": {
        "response_generation": {
            "templates": {
                "climate_info": "The climate in {district} is characterized by {climate_profile}.",
                "risk_assessment": "The main climate risks in {district} include {climate_risks}.",
                "adaptation": "Adaptation measures in {district} include {adaptation_measures}."
            },
            "data_sources": {
                "climate": ["district_data", "sensor_data", "weather_services"],
                "research": ["papers", "local_research"],
                "sdg": ["indicators", "local_implementation"]
            }
        },
        "query_handling": {
            "intent_mapping": {
                "climate_inquiry": ["district_data", "sensor_data"],
                "research_inquiry": ["papers"],
                "sdg_inquiry": ["indicators"]
            },
            "fallback_sources": {
                "primary": "district_data",
                "secondary": "sensor_data",
                "tertiary": "weather_services"
            }
        }
    }
} 